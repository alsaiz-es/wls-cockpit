# Target WLS AdminServer to proxy through Vite dev server.
# In dev, the app calls /api/wls/* and Vite forwards it here, bypassing CORS.
VITE_WLS_TARGET=http://wls-admin.example.com:7001

# Default WLS REST API version path segment. Supported in MVP: 14.1.2.0.0 and 12.2.1.4.0
VITE_WLS_DEFAULT_VERSION=14.1.2.0.0
